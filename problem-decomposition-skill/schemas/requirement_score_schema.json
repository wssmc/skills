{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RequirementCompletenessScore",
  "type": "object",
  "properties": {
    "score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "missing_core_items": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ready_for_literature_review": {
      "type": "boolean"
    },
    "ready_for_mip_generation": {
      "type": "boolean"
    }
  }
}
