{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProblemFingerprint",
  "type": "object",
  "required": [
    "problem_type",
    "objective",
    "constraints",
    "data_format",
    "expected_outputs"
  ],
  "properties": {
    "problem_type": {
      "type": "string"
    },
    "shop_type_aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "objective": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "entities": {
      "type": "object"
    },
    "constraints": {
      "type": "object"
    },
    "data_format": {
      "type": "object"
    },
    "solver_preference": {
      "type": "string"
    },
    "expected_outputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
