{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Problem Feature Table Row Schema",
  "type": "object",
  "required": ["Study", "Shop", "Objective", "Method"],
  "properties": {
    "Study": {"type": "string"},
    "Shop": {"type": "string"},
    "Objective": {"type": "string"},
    "Due windows": {"enum": ["Yes", "No", "Unclear", "Not reported"]},
    "Priority jobs": {"enum": ["Yes", "No", "Unclear", "Not reported"]},
    "Shared windows": {"enum": ["Yes", "No", "Unclear", "Not reported"]},
    "MUPs": {"enum": ["Yes", "No", "Unclear", "Not reported"]},
    "Setup": {"enum": ["Yes", "No", "Unclear", "Not reported"]},
    "Blocking": {"enum": ["Yes", "No", "Unclear", "Not reported"]},
    "Transport": {"enum": ["Yes", "No", "Unclear", "Not reported"]},
    "Worker": {"enum": ["Yes", "No", "Unclear", "Not reported"]},
    "Method": {"type": "string"},
    "Similarity": {"type": "string"},
    "Key difference": {"type": "string"}
  }
}
