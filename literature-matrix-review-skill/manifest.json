{
  "name": "literature-matrix-review-skill",
  "version": "1.1.0",
  "description": "A research workflow skill for retrieving, screening, reading, and summarizing scheduling/optimization literature into problem-based and method-based comparison matrices.",
  "language": "zh-CN",
  "primary_domain": "scheduling optimization literature review",
  "inputs": [
    "raw_problem_text",
    "refined_problem_description",
    "problem_fingerprint",
    "seed_papers",
    "search_scope",
    "target_table_columns"
  ],
  "outputs": [
    "problem_fingerprint.json",
    "search_queries.txt",
    "screening_records.csv",
    "paper_reading_cards.md",
    "problem_feature_table.md",
    "problem_feature_table.csv",
    "method_matrix_table.md",
    "method_matrix_table.csv",
    "novelty_gap_summary.md",
    "literature_review_draft.md",
    "references.bib"
  ],
  "recommended_previous_skill": "problem-decomposition-skill",
  "recommended_next_skill": "mip-hfsp-project-generator-skill",
  "upstream_skills": [
    "problem-decomposition-skill"
  ],
  "downstream_skills": [
    "mip-hfsp-project-generator-skill"
  ]
}
